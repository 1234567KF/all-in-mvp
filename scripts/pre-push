#!/bin/bash
# ============================================================
#  pre-push hook: 推库前自动同步 skills + agents → .claude/.qoder/.trae
# ============================================================
#
# 在每次 git push 前自动执行：
#   1. npm run sync （skills 同步 + overlay 融合）
#   2. powershell .\tools\generate.ps1 all（agents 生成 + pipeline-monitor）
#   3. 若有变更则自动提交
#   4. 确保三个平台目录在仓库中始终最新
#
# 用户 giget 拉取后，.claude/.qoder/.trae 已是最新，
# 只需直接复制到全局目录即可，无需再次下载。
# ============================================================

set -e

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  pre-push: 检查技能同步状态..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Step 1: 运行 skills 同步（push 模式 + force 跳过确认）
node scripts/sync-skills.js --mode push --force

echo ""

# Step 2: 运行 agents + pipeline-monitor 生成
if powershell.exe -NoProfile -Command "exit 0" 2>/dev/null; then
    echo "→ 生成 agents + pipeline-monitor..."
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/generate.ps1 all
else
    echo "⚠ PowerShell 不可用，跳过 agents 生成"
    echo "   请手动运行: .\\tools\\generate.ps1 all"
fi

echo ""

# Step 3: 检查 skills + agents 目录是否有变更
changes=$(git status --porcelain -- .claude/skills/ .qoder/skills/ .trae/skills/ .claude/agents/ .qoder/agents/ 2>/dev/null || true)

if [ -n "$changes" ]; then
    echo "📦 检测到同步变更，自动提交..."
    echo ""
    echo "$changes"
    echo ""

    git add .claude/skills/ .qoder/skills/ .trae/skills/ .claude/agents/ .qoder/agents/
    git commit -m "sync: pre-push 自动同步技能 + agents 到平台目录 (.claude/.qoder/.trae)"

    echo ""
    echo "✅ 已提交同步变更，继续推送..."
else
    echo "✅ 技能 + agents 已是最新，无需同步"
fi

echo ""
exit 0
