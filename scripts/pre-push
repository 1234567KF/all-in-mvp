#!/bin/bash
# ============================================================
#  pre-push hook: 推库前自动同步 skills → .claude/.qoder/.trae
# ============================================================
#
# 在每次 git push 前自动执行：
#   1. npm run sync （含 overlay 融合）
#   2. 若有变更则自动提交
#   3. 确保三个平台目录在仓库中始终最新
#
# 用户 giget 拉取后，.claude/.qoder/.trae 已是最新，
# 只需直接复制到全局目录即可，无需再次下载。
# ============================================================

set -e

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  pre-push: 检查技能同步状态..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# 运行同步（push 模式 + force 跳过确认）
node scripts/sync-skills.js --mode push --force

echo ""

# 检查三个平台目录是否有变更
changes=$(git status --porcelain -- .claude/skills/ .qoder/skills/ .trae/skills/ 2>/dev/null || true)

if [ -n "$changes" ]; then
    echo "📦 检测到同步变更，自动提交..."
    echo ""
    echo "$changes"
    echo ""

    git add .claude/skills/ .qoder/skills/ .trae/skills/
    git commit -m "sync: pre-push 自动同步技能到平台目录 (.claude/.qoder/.trae)"

    echo ""
    echo "✅ 已提交同步变更，继续推送..."
else
    echo "✅ 技能已是最新，无需同步"
fi

echo ""
exit 0
