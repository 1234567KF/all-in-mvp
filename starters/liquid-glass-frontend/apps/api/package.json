{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate:check": "bun run scripts/migrate-check.ts",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "jsonwebtoken": "^9.0.0",
    "shared": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.13.2",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
