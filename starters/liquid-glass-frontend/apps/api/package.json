{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --fix",
    "db:generate": "bun scripts/db-generate.ts",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:reset": "bun scripts/reset-db.ts",
    "db:seed-dev": "bun scripts/seed-dev.ts",
    "migrate:check": "bun run scripts/migrate-check.ts",
    "test": "bun test",
    "db:init:generate": "bun scripts/gen-init-sql.ts",
    "db:init:check": "bun scripts/gen-init-sql.ts --check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "shared": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
