package com.example

import org.springframework.boot.autoconfigure.SpringBootApplication
import org.springframework.boot.runApplication
import org.springframework.web.bind.annotation.GetMapping
import org.springframework.web.bind.annotation.RestController
import org.springframework.web.bind.annotation.CrossOrigin
import org.springframework.data.jpa.repository.JpaRepository
import org.springframework.stereotype.Repository
import jakarta.persistence.Entity
import jakarta.persistence.Id
import jakarta.persistence.GeneratedValue
import jakarta.persistence.GenerationType
import jakarta.persistence.Table
import org.springframework.beans.factory.annotation.Autowired
import org.springframework.boot.CommandLineRunner
import org.springframework.context.annotation.Bean

@SpringBootApplication
class App {
    @Bean
    fun demo(repository: UserRepository): CommandLineRunner {
        return CommandLineRunner {
            if (repository.count() == 0L) {
                val admin = User(
                    email = "admin@liquid.glass",
                    name = "Kotlin Admin",
                    role = "admin"
                )
                repository.save(admin)
                println("🌱 Seeded admin user into Kotlin H2 database.")
            }
        }
    }
}

fun main(args: Array<String>) {
    runApplication<App>(*args)
}

@Entity
@Table(name = "users")
class User(
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    var id: Long? = null,
    var email: String = "",
    var name: String = "",
    var role: String = ""
)

@Repository
interface UserRepository : JpaRepository<User, Long>

@RestController
@CrossOrigin(origins = ["*"])
class ApiController @Autowired constructor(
    private val userRepository: UserRepository
) {
    @GetMapping("/api/hello")
    fun hello(): Map<String, String> {
        return mapOf("message" to "Hello from Spring Boot + Kotlin + Gradle + H2 Backend!")
    }

    @GetMapping("/api/users")
    fun getUsers(): List<User> {
        return userRepository.findAll()
    }
}
