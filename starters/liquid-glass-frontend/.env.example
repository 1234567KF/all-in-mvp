# ── Frontend (Vite dev) ───────────────────────────────────────────────
# 仅在 `bun run dev:web` 时生效。生产由 Hono 同域托管，无需设置这些。
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_TITLE=My App
VITE_AUTH_REFRESH_PATH=/api/auth/refresh

# ── Server（生产 / 容器）────────────────────────────────────────────────
# server 容器内监听端口（固定 3000，勿改；compose 会映射到宿主 WEB_PORT）
PORT=3000
# 宿主机对外暴露端口（默认 80；开发/测试机常设 8081 避开占用）
WEB_PORT=80
# production 时 Hono 直接托管前端静态文件（/app/web）并处理 /api 路由，替代 nginx
NODE_ENV=production
# 若不设 NODE_ENV=production 但仍希望托管静态：SERVE_STATIC=true

# ── Database（可选，默认 ${cwd}/data）──
# SQLite 数据目录；Docker 部署时默认 /app/data（compose 卷映射 ./data:/app/data）
# 结构来源自动探测：init.sql（如存在）或 drizzle/ 迁移目录，通常无需设置
# DATA_DIR=/app/data

# ── Auth ──
JWT_SECRET=change-me-in-production
# 前端源，生产必填（用于 CORS）；同域 Hono 托管时可写公网域名
FRONTEND_URL=http://localhost:5173

# ── Object Storage（可选：阿里云 OSS 双模，见 apps/api/src/shared/oss.ts）──
# 三项（AK ID / AK Secret / Bucket）同时配置才启用 OSS 模式；缺任意一项自动降级为
# 本地 mock 模式（上传/下载走业务方定义的本地回退路由，无云账号也能开发上传链路）。
# 生产环境禁止半启用（只配一两项会启动失败，避免静默降级到不可用链路）。
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# 自定义 OSS 服务 endpoint（内网/代理场景，如 https://oss-cn-hangzhou-internal.aliyuncs.com）
# 直传 host 会按 ali-oss 默认 cname=false 语义自动拼 `${bucket}.`（IP 形式 endpoint 不拼）；
# 纯 IP endpoint 受 ali-oss 限制不支持生成签名下载 URL（服务端对象操作/直传可用），推荐使用域名
# OSS_ENDPOINT=
# 对象 key 统一前缀（多环境共用 bucket 时隔离，如 my-app/dev）
# OSS_PREFIX=
# CDN 域名：配置后签名 URL 用 CDN 域名替换 OSS 默认域名
# OSS_CDN_DOMAIN=
# 上传大小上限（MB，默认 10），同时写入 OSS Post Policy
# UPLOAD_MAX_SIZE_MB=10

# ── SQLite 运维（可选）──
# 备份默认落在 ${DATA_DIR}/backups 并保留最近 30 份，OSS 模式下自动上传云端，无需额外配置

# ── Seed ──
SEED_ADMIN_PASSWORD=change-me-in-production

# ── Demo（仅演示 / 测试环境，真实项目请勿开启）──
# true 时：启动幂等补齐 7 条演示通知 + 开放 POST /notifications/dev/{push,reset}
# 演示态被点完/删完后：POST /notifications/dev/reset 一键恢复（4 未读/3 已读）
# DEMO_MODE=true

# ── 说明 ──
# CORS 生产同域部署由 Hono 托管前端，无需额外配置（来源取 FRONTEND_URL）。
# 本地 Vite proxy 拿不到客户端 IP 时，操作日志会记录代理地址（无兜底变量）。
