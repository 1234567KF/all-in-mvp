# ── Frontend (Vite dev) ───────────────────────────────────────────────
# 仅在 `bun run dev:web` 时生效。生产由 Hono 同域托管，无需设置这些。
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_TITLE=My App
VITE_AUTH_REFRESH_PATH=/api/auth/refresh

# ── Server（生产 / 容器）────────────────────────────────────────────────
# server 容器内监听端口（固定 3000，勿改；compose 会映射到宿主 WEB_PORT）
PORT=3000
# 宿主机对外暴露端口（默认 80；开发/测试机常设 8081 避开占用）
WEB_PORT=80
# production 时 Hono 直接托管前端静态文件（/app/web）并处理 /api 路由，替代 nginx
NODE_ENV=production
# 若不设 NODE_ENV=production 但仍希望托管静态：SERVE_STATIC=true

# ── Database（可选，默认 ${cwd}/data 和 ${cwd}/drizzle）──
# Docker 部署时通过 compose 卷映射 ./data:/app/data
# DATA_DIR=/app/data
# MIGRATIONS_DIR=/app/drizzle

# ── Auth ──
JWT_SECRET=change-me-in-production
# 前端源，生产必填（用于 CORS）；同域 Hono 托管时可写公网域名
FRONTEND_URL=http://localhost:5173

# ── Seed ──
SEED_ADMIN_PASSWORD=change-me-in-production

# ── CORS（可选，生产同域部署由 Hono 托管前端，无需设置）──
# CORS_ORIGINS=https://example.com

# ── 开发调试（可选）──
# 本地 Vite proxy 无法获取客户端 IP，可设置此变量作为操作日志 IP 兜底值
# DEV_IP_FALLBACK=192.168.1.100
# API 后端地址
VITE_API_BASE_URL=http://localhost:3001

# 应用标题
VITE_APP_TITLE=My App

# Token 刷新端点路径（相对于 API_BASE_URL）
VITE_AUTH_REFRESH_PATH=/api/auth/refresh
