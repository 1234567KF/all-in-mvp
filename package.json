{
  "name": "all-in-mvp",
  "version": "2.8.0",
  "description": "多 Agent 并行 MVP 开发流水线技能集 — npx giget 一键拉取，开箱即用",
  "repository": {
    "type": "git",
    "url": "https://github.com/1234567KF/all-in-mvp.git"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.js",
    "setup": "node scripts/sync-skills.js --mode push --force",
    "sync": "node scripts/sync-skills.js --mode push",
    "sync:pull": "node scripts/sync-skills.js --mode pull",
    "sync:merge": "node scripts/sync-skills.js --mode merge",
    "sync:interactive": "node scripts/sync-skills.js --mode interactive",
    "sync:claude": "node scripts/sync-skills.js --mode push --target claude",
    "sync:qoder": "node scripts/sync-skills.js --mode push --target qoder",
    "sync:trae": "node scripts/sync-skills.js --mode push --target trae",
    "sync:dry-run": "node scripts/sync-skills.js --mode push --dry-run",
    "sync:backup": "node scripts/sync-skills.js --mode push --backup",
    "e2e:sanitize": "node scripts/e2e-sanitizer.js",
    "e2e:full": "node scripts/e2e-full-regression.js",
    "e2e:env": "node scripts/check-e2e-env.js",
    "e2e:coverage": "node scripts/check-e2e-coverage.js"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "keywords": [
    "mvp",
    "multi-agent",
    "pipeline",
    "tdd",
    "e2e-testing",
    "starter",
    "giget",
    "claude-code",
    "qoder",
    "prototype"
  ],
  "author": "1234567KF",
  "license": "MIT",
  "giget": {
    "description": "使用 npx giget gh:1234567KF/all-in-mvp#all-in-mvp --ignore \"...\" 一键拉取 MVP 项目模板（自动排除文档/白皮书等元数据，仅分发核心技能与脚本）"
  }
}
